# Copy to .env (never commit .env) or fill these in Dokploy's Environment tab.

# First login account. Only used while the database has no account yet; after the
# first successful start you can (and should) remove the password from here and
# change it from the dashboard (Pengaturan -> Akun Login).
AUTOPOSTER_ADMIN_EMAIL=
AUTOPOSTER_ADMIN_PASSWORD=

# Timezone in which the Fanspage posting times (auto_post_times) are read.
# Posting times are entered in WIB (Asia/Jakarta); convert to the audience's local time yourself.
SCHEDULER_TIMEZONE=Asia/Jakarta

# Optional
# FB_GRAPH_API_VERSION=v25.0

# Only if the VPS cannot reach part of Fastly (PyPI's CDN) and builds time out at
# "pip install": pin PyPI to a Fastly address that works from the VPS. Packages still
# come from the official PyPI over verified TLS. Leave empty everywhere else.
# PYPI_HOST_OVERRIDE=pypi.org:199.232.192.223
# PYPI_FILES_HOST_OVERRIDE=files.pythonhosted.org:199.232.192.223
